# Trước đây bắt buộc vì @react-three/drei@9 khai peer react@^18 còn project chạy
# react@19. Drei đã được gỡ (2026-08-16) nên nguyên nhân đó không còn: giải phụ
# thuộc với --legacy-peer-deps=false chạy sạch, không package nào còn khai peer
# react loại trừ 19.
#
# VẪN GIỮ vì bỏ dòng này làm npm phân loại lại 29 binary của rolldown/vite từ
# dev sang production — Docker build (`npm ci --omit=dev`) sẽ kéo thêm binary
# đa nền tảng không cần thiết. Muốn bỏ thì phải xử lý phần đó trước.
legacy-peer-deps=true
